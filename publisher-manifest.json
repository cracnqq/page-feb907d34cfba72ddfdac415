y);border:2px solid var(--wine);border-radius:50%}\n  .timeline .stamp{display:inline-block;font-size:12px;letter-spacing:.22em;color:var(--wine-soft);margin-bottom:4px}\n  .timeline h3{font-size:19px;margin:0 0 6px;color:var(--wine-deep)}\n  .timeline p{margin:0;color:var(--ink-soft);font-size:15px;max-width:44em}\n  .timeline a{font-size:14px}\n\n  section{padding:52px 0;border-bottom:1px solid var(--line)}\n  section:last-of-type{border-bottom:0}\n  .sec-head{display:flex;align-items:baseline;gap:16px;margin-bottom:28px;flex-wrap:wrap}\n  .sec-num{font-size:12px;letter-spacing:.28em;color:var(--wine-soft);border:1px solid var(--line);padding:3px 9px;white-space:nowrap}\n  h2{font-size:clamp(23px,3.6vw,30px);margin:0;color:var(--wine-deep)}\n  .sec-lead{color:var(--ink-soft);max-width:46em;font-size:15.5px;margin-bottom:26px}\n\n  /* 票据卡片 */\n  .ticket{border:2px dashed var(--wine-soft);background:#fffdf8;padding:26px 26px 24px;position:relative}\n  .ticket::after{content:\"\";position:absolute;left:22px;right:22px;bottom:14px;border-bottom:1px dotted var(--line)}\n  .ticket .tag{font-size:12px;letter-spacing:.2em;color:var(--wine-soft);display:block;margin-bottom:8px}\n  .ticket h3{margin:0 0 10px;font-size:20px;color:var(--wine-deep)}\n  .ticket ul{margin:0;padding-left:20px;color:var(--ink-soft);font-size:15px}\n  .ticket ul li{margin-bottom:6px}\n\n  /* 阶梯式套餐 */\n  .stairs{display:flex;flex-direction:column;gap:22px}\n  .step{border:2px dashed var(--wine-soft);background:#fffdf8;padding:26px 26px 22px;margin-right:0}\n  .step-1{margin-right:24%}\n  .step-2{margin-left:12%;margin-right:12%;background:#fffaf0;border-color:var(--wine)}\n  .step-3{margin-left:24%}\n  .step-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:6px}\n  .step-name{font-size:21px;margin:0;color:var(--wine-deep)}\n  .price{font-family:Georgia,serif;font-size:26px;color:var(--wine);white-space:nowrap}\n  .price small{font-size:13px;color:var(--ink-soft);font-family:inherit;letter-spacing:.04em}\n  .annual{font-size:14px;color:var(--wine-soft);margin:0 0 14px;letter-spacing:.04em}\n  .badge{display:inline-block;font-size:11px;letter-spacing:.24em;color:var(--ivory);background:var(--wine);padding:2px 8px;margin-left:8px;vertical-align:2px}\n  .step ul{margin:0;padding:0;list-style:none}\n  .step ul li{font-size:15px;color:var(--ink-soft);padding:6px 0 6px 22px;position:relative;border-bottom:1px dotted var(--line)}\n  .step ul li:last-child{border-bottom:0}\n  .step ul li::before{content:\"—\";position:absolute;left:0;color:var(--wine-soft)}\n  .note{font-size:14px;color:var(--ink-soft);border-left:3px solid var(--wine-soft);padding:4px 0 4px 14px;margin-top:22px;max-width:46em}\n\n  /* 客户端与说明 */\n  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:22px}\n  .plain-block h3{font-size:18px;margin:0 0 8px;color:var(--wine-deep)}\n  .plain-block p{font-size:15px;color:var(--ink-soft)}\n  .plain-block ol{margin:0;padding-left:20px;font-size:15px;color:var(--ink-soft)}\n  .plain-block ol li{margin-bottom:8px}\n\n  /* FAQ 分组 */\n  .faq-group{margin-bottom:34px}\n  .faq-group:last-child{margin-bottom:0}\n  .faq-group > h3{font-size:16px;letter-spacing:.2em;color:var(--wine);margin:0 0 16px;padding-bottom:8px;border-bottom:1px solid var(--line)}\n  .qa{display:grid;grid-template-columns:1fr 1fr;gap:0 26px;padding:14px 0;border-bottom:1px dotted var(--line)}\n  .qa:last-child{border-bottom:0}\n  .qa dt{font-weight:700;color:var(--wine-deep);font-size:15.5px}\n  .qa dd{margin:0;font-size:15px;color:var(--ink-soft)}\n\n  footer{background:var(--wine-deep);color:var(--ivory-warm);padding:38px 0 34px;font-size:14px}\n  footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:flex-end}\n  footer strong{letter-spacing:.28em;color:#fff;font-weight:700}\n  footer p{margin:6px 0 0;max-width:36em;color:rgba(246,241,230,.72)}\n  footer a{color:var(--ivory);border-bottom:1px dotted rgba(246,241,230,.5)}\n\n  @media (max-width:760px){\n    .step-1,.step-2,.step-3{margin-left:0;margin-right:0}\n    .two-col{grid-template-columns:1fr}\n    .qa{grid-template-columns:1fr;gap:6px}\n    header.hero{padding-top:40px}\n    .timeline{padding-left:24px}\n    .timeline li::before{left:-33px}\n    section{padding:40px 0}\n    .ticket{padding:22px 20px}\n  }\n</style><div class=\"bar\">\n  <div class=\"wrap\">\n    <span class=\"mark\">一云梯</span>\n    <nav class=\"jump\" aria-label=\"页面内跳转\">\n      <a href=\"#how\">使用顺序</a>\n      <a href=\"#plans\">套餐阶梯</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-intro\">\n      <div class=\"hero-kicker\">一云梯 · 说明页</div>\n      <h1>一云梯：先把顺序搞清，再决定要不要付钱</h1>\n      <p>这一页不讲形容词，只讲先后。往下是一条时间线：你会在哪一步用到什么，哪一步需要花钱，哪一步只需要花十分钟。看完整条线，再回到任何一个环节都可以。</p>\n    </div>\n\n    <ol class=\"timeline\">\n      <li>\n        <span class=\"stamp\">第 1 步</span>\n        <h3>先看清自己一个月大概用多少</h3>\n        <p>把设备数、每天在网时长、是否看高清片源这三件事写在纸上。数字算不准，后面的套餐就只会买多或买少。</p>\n      </li>\n      <li>\n        <span class=\"stamp\">第 2 步</span>\n        <h3>对照套餐阶梯，挑一档起步</h3>\n        <p>三档按价格从低到高排开，每档的流量和可同时在线设备数写在明面上。<a href=\"#plans\">直接看阶梯</a></p>\n      </li>\n      <li>\n        <span class=\"stamp\">第 3 步</span>\n        <h3>在常用设备上装好客户端</h3>\n        <p>先装一台，确认能用再铺开到第二台、第三台。同时装一堆设备，出问题时反而不好判断是哪一端的问题。<a href=\"#clients\">看客户端说明</a></p>\n      </li>\n      <li>\n        <span class=\"stamp\">第 4 步</span>\n        <h3>连续用一周，再决定要不要按年</h3>\n        <p>一周的用量比任何估算都可靠。月付一个月之后，再考虑是否换成年付方式，这样决定不算冒险。</p>\n      </li>\n      <li>\n        <span class=\"stamp\">第 5 步</span>\n        <h3>把问题记下来，别攒着</h3>\n        <p>遇到连不上、速度不对、某台设备异常，先记录下来，再去常见问题里对一遍。<a href=\"#faq\">跳到常见问题</a></p>\n      </li>\n    </ol>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">说明 01</span>\n        <h2>使用前要准备的三件事</h2>\n      </div>\n      <p class=\"sec-lead\">清单式写，逐条对照即可。本节只列必要的准备动作，不涉及任何服务承诺。</p>\n      <div class=\"two-col\">\n        <div class=\"ticket\">\n          <span class=\"tag\">清单 A · 设备</span>\n          <h3>先把设备数点清楚</h3>\n          <ul>\n            <li>手机、电脑、平板各几台，逐台写下来</li>\n            <li>有没有需要长期在线的设备，比如家里的电视盒子</li>\n            <li>同一时间会同时上线几台，这是关键数字</li>\n            <li>临时借用别人的设备，不计入长期数量</li>\n          </ul>\n        </div>\n        <div class=\"ticket\">\n          <span class=\"tag\">清单 B · 用量</span>\n          <h3>再估算一个月的流量</h3>\n          <ul>\n            <li>只收发消息和看网页，用量通常很小</li>\n            <li>常看高清视频，用量会明显上升</li>\n            <li>需要长时间下载或同步文件，单独记一笔</li>\n            <li>把一周的估算值乘四，留一点余量</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"two-col\">\n        <div class=\"ticket\">\n          <span class=\"tag\">清单 C · 网络</span>\n          <h3>确认你所在环境的网络状况</h3>\n          <ul>\n            <li>先测一次本机当前的网络速度，作为参照</li>\n            <li>记下常用地点的网络：家里、办公室、常去的咖啡馆</li>\n            <li>如果某个地点本身就不稳定，先分清是哪一端的问题</li>\n            <li>换一个地点再试，是比较快的判断方式</li>\n          </ul>\n        </div>\n        <div class=\"ticket\">\n          <span class=\"tag\">清单 D · 预算</span>\n          <h3>给每月支出划一条线</h3>\n          <ul>\n            <li>先定一个月度金额上限，再去选档</li>\n            <li>年付方式的总支出低于月付累加，但需要一次付清</li>\n            <li>不确定会不会长期使用时，先按月付</li>\n            <li>团队使用请按实际人数估算，而不是按最高档先买</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">说明 02</span>\n        <h2>三档套餐，按价格阶梯排开</h2>\n      </div>\n      <p class=\"sec-lead\">从低到高依次是基础版、旗舰版、团队版。每一档写明流量、可同时在线设备数与对应权益，按你的清单 A 和清单 B 对号入座即可。</p>\n\n      <div class=\"stairs\">\n\n        <article class=\"step step-1\">\n          <div class=\"step-head\">\n            <h3 class=\"step-name\">基础版</h3>\n            <div class=\"price\">¥15<small> / 月</small></div>\n          </div>\n          <p class=\"annual\">按年付 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>最多 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"step step-2\">\n          <div class=\"step-head\">\n            <h3 class=\"step-name\">旗舰版<span class=\"badge\">推荐</span></h3>\n            <div class=\"price\">¥35<small> / 月</small></div>\n          </div>\n          <p class=\"annual\">按年付 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>最多 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"step step-3\">\n          <div class=\"step-head\">\n            <h3 class=\"step-name\">团队版</h3>\n            <div class=\"price\">¥85<small> / 月</small></div>\n          </div>\n          <p class=\"annual\">按年付 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>最多 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"note\">价格与权益以上方卡片中列出的内容为准。个人日常使用多在基础版和旗舰版之间取舍，团队版请按实际人数与设备数评估后再决定。这里不提供购买入口，页面内所有链接均为站内跳转。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">说明 03</span>\n        <h2>客户端怎么装、怎么排顺序</h2>\n      </div>\n      <p class=\"sec-lead\">装客户端的顺序比速度更重要。先把一台跑通，再来第二台，出问题时才找得到原因。</p>\n\n      <div class=\"two-col\">\n        <div class=\"plain-block\">\n          <h3>安装顺序（逐条照做）</h3>\n          <ol>\n            <li>选一台你用得最多的设备作为第一台，通常是手机或主力电脑。</li>\n            <li>按该设备对应的系统选择客户端版本，不要跨系统混装。</li>\n            <li>装完后先不做任何改动，确认能正常加载页面。</li>\n            <li>能正常使用之后，再把你常用的规则或偏好设一遍。</li>\n            <li>第二台设备照同样流程做一次，一般会更顺利。</li>\n            <li>把所有已安装设备的系统与版本记在一处，日后排查方便。</li>\n          </ol>\n        </div>\n        <div class=\"plain-block\">\n          <h3>安装时要留意的四点</h3>\n          <p>第一点，卸载旧的同类客户端，避免两个同时运行。第二点，安装包只从你信任的来源取，页面不提供下载地址。</p>\n          <p>第三点，装完之后看一项：设备时间是否准确，时间偏差会带来莫名其妙的连接问题。第四点，遇到问题先重启客户端，再重启设备，两件事做完再判断。</p>\n          <p>同时在线设备数对应你选的档位，超出上限时可能无法继续添加设备。要加设备，先看套餐里的数字，再加。</p>\n        </div>\n      </div>\n\n      <div class=\"ticket\">\n        <span class=\"tag\">常见三端 · 说明</span>\n        <h3>手机、电脑、平板各注意一点</h3>\n        <ul>\n          <li>手机端：注意系统在后台清理应用，长期在线时把它加入后台保留名单。</li>\n          <li>电脑端：注意与系统代理设置是否冲突，二者只能留一个生效。</li>\n          <li>平板端：与手机端流程基本一致，但可同时在线名额是一起算的。</li>\n          <li>所有设备：安装完成后统一记录一次设备名称，便于对照套餐名额。</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">说明 04</span>\n        <h2>常见问题，按主题分组</h2>\n      </div>\n      <p class=\"sec-lead\">按主题分成四组：选购、用量、设备与排查。每组先问后答，答案尽量短，能直接照做。</p>\n\n      <div class=\"faq-group\">\n        <h3>一 · 选购相关</h3>\n        <dl>\n          <div class=\"qa\">\n            <dt>三档套餐我该从哪一档开始？</dt>\n            <dd>先用清单 A 点清同时上线的设备数，再看清单 B 的一周用量估算。设备数在三台以内、用量不大，从基础版开始；设备数五台左右、常看高清视频，看旗舰版；人数多且要统一管理，再考虑团队版。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>先月付还是先年付？</dt>\n            <dd>建议先月付一个月。用满一个月后，你会对自己真实的流量和稳定性有判断，那时再决定要不要一次付清年费，比安装第一天就决定要稳。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>付费方式不确定怎么办？</dt>\n            <dd>本页不提供支付入口，也不代表任何交易流程。价格与权益仅以套餐卡片中的文字为准，其余与付款有关的操作请通过你获取服务的正规渠道确认。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>以后想换档位，会不会麻烦？</dt>\n            <dd>换档主要看两个数字：流量额度与可同时在线设备数。换之前先记录当前用量，再看目标档位是否覆盖，按这个顺序判断即可，不必一次调到最高档。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>二 · 流量与用量</h3>\n        <dl>\n          <div class=\"qa\">\n            <dt>每月 100GB 大概是什么概念？</dt>\n            <dd>只收发文字消息、浏览网页和看短视频，通常用不完。若每天长时间看高清片源，用量会上升很快，这时要么减少清晰度，要么考虑更高一档。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>怎么知道自己用了多少？</dt>\n            <dd>以你自己记录为准：每周固定一天看一眼用量，记在纸上或表格里。连续记三周，你就能预估整月的走向，这比临时估算准得多。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>用量快超了怎么处理？</dt>\n            <dd>先找出最耗流量的那一项，通常是视频清晰度或后台自动同步。先把这一项降下来，再看是否真的需要换档，避免习惯性调档。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>团队版的 1000GB 是给一个人用的吗？</dt>\n            <dd>不是，它是整个账户共用的额度。按人数与设备数估算，把每个人的大致用量加起来，再和 1000GB 对比。人少却选团队版，多半是浪费。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>三 · 设备与同时在线</h3>\n        <dl>\n          <div class=\"qa\">\n            <dt>同时在线设备数是怎么算的？</dt>\n            <dd>按同一时间处于连接状态的设备计算。手机、电脑、平板一起开，就一起占名额。基础版 3 台、旗舰版 5 台、团队版 20 台。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>旧手机想留着当备用，会占名额吗？</dt>\n            <dd>只有在它处于连接状态时才占。长期不用就退出连接，需要时再开，名额就不会被闲置设备占着。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>家里电视盒子算一台设备吗？</dt>\n            <dd>算，而且它通常长期在线。如果家里有这类常开设备，估算名额时要单独为它留一位，别按你手边的手机电脑数量直接对上。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>多台设备放在同一处网络下会有影响吗？</dt>\n            <dd>同一网络下的设备越多，共享出口带宽的压力越大。观察一下多台同时使用时是否变慢，如果明显变慢，先减少同时在线的设备数，再判断其他原因。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>四 · 排查与求助</h3>\n        <dl>\n          <div class=\"qa\">\n            <dt>装好之后打不开页面，先查什么？</dt>\n            <dd>按顺序查四件事：设备时间是否准确、是否还运行着旧的同类客户端、系统代理设置是否冲突、换一个网络环境是否恢复。四项查完一般能定位到原因。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>只有某一台设备有问题，其他正常，怎么办？</dt>\n            <dd>这说明问题多半在这台设备上，而不是整体。先卸载重装这台设备的客户端，并检查它的后台限制与权限设置，不需要去动其他正常的设备。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>速度比预期慢，该先排除什么？</dt>\n            <dd>先测一次本机网络作为参照，再换一个网络环境对比。如果换了环境就正常，问题在原网络；如果换了还是慢，再去看设备端与客户端版本。先分清哪一端，再动手。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>需要反馈问题时，准备什么信息？</dt>\n            <dd>三样就够：使用设备与系统版本、问题出现的大致时间、问题发生前你做了什么操作。写清这三样，沟通会快很多，也能避免来回确认。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <p class=\"note\">本页只做说明与整理，不提供下载地址、支付入口，也不对可用性、速度或节点状况作出承诺。遇到页面未覆盖的情况，请以你获取服务的正规渠道所提供的信息为准。</p>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <strong>一云梯</strong>\n      <p>一页说明：顺序、套餐、客户端与常见问题。内容以本页文字为准，价格与权益对应上方三档套餐卡片。</p>\n    </div>\n    <p><a href=\"#how\">回到使用顺序</a> · <a href=\"#faq\">常见问题</a></p>\n  </div>\n</footer>",
